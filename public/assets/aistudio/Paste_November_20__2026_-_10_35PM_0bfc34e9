    /* Fetch the receipt by id from the URL query string and render it.
       Ownership is enforced server-side: the API only returns receipts
       belonging to the signed-in account's session cookie. */
    const id = new URLSearchParams(location.search).get("id");

    const money = (c) => "$" + (c / 100).toFixed(2);

    (async function render() {
      if (!id) {
        document.getElementById("receipt-body").textContent = "Missing receipt id.";
        return;
      }
      const res = await fetch("/api/receipts/" + encodeURIComponent(id));
      if (!res.ok) {
        document.getElementById("receipt-body").textContent =
          res.status === 401 ? "Sign in first (open the rider app)." : "Receipt not found.";
        return;
      }
      const [{ receipt: r, ticket }, me] = await Promise.all([
        res.clone().json(),
        fetch("/api/me").then((m) => m.json()),
      ]);
      const rows = [
        ["Receipt number", r.id],
        ["Date", new Date(r.created_at).toLocaleString()],
        ["Customer", me.signed_in ? me.email : "—"],
        ["Type", `<span class="badge ${r.type}">${r.type}</span>`],
        ["Description", r.description],
        ["Payment method", r.method],
        ["Status", `<span class="badge ${r.status}">${r.status}</span>`],
        ["Total", `<strong>${money(r.amount_cents)}</strong>`],
