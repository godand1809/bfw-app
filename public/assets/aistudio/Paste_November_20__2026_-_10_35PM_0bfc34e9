        <p style="margin-top:16px;font-size:12px">
          Ben Franklin Transit · 1000 W Columbia Dr, Kennewick, WA 99336 · bft.org<br>
          Keep this receipt as proof of payment. Fares are non-transferable.
        </p>`;
    })();
  </script>
</body>
</html>
