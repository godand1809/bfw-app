        rows.push(["Ticket", ticket.id]);
        rows.push(["Fare product", ticket.product_name]);
        rows.push(["Ticket status", `<span class="badge ${ticket.status}">${ticket.status}</span>`]);
        rows.push(["Rides remaining", ticket.rides_remaining === null ? "Unlimited" : ticket.rides_remaining]);
        rows.push(["Valid until", new Date(ticket.expires_at).toLocaleString()]);
      }
      document.getElementById("receipt-body").innerHTML = `
        <table style="margin-top:8px">
          ${rows.map(([k, v]) => `<tr><td style="color:var(--muted);width:160px">${k}</td><td>${v}</td></tr>`).join("")}
